# ==============================================================================
# LessonForge Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for AI generation & QC)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Tavily Search API Key (Optional: for enhanced web research with full extracts)
# If not provided, LessonForge automatically falls back to DuckDuckGo + Trafilatura
# Get your key at: https://tavily.com/
TAVILY_API_KEY=

# Google Books API Key (Optional: keyless endpoint works by default with rate limits)
# Get your key at: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# YouTube Data API v3 Key (Optional: for YouTube search)
# Get your key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# App Environment (development / production)
ENVIRONMENT=development

# Storage Directory for Lessons
LESSONFORGE_DATA_DIR=data/lessons
